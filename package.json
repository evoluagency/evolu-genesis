{
  "name": "@evolu/platform-ux-contracts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck",
    "build:preview-runtime": "tsc -p tsconfig.preview.json",
    "homologate:browser": "node scripts/ux-browser-homologation.mjs",
    "homologate:browser:selftest": "node scripts/ux-browser-homologation.mjs --self-test",
    "test:adapters": "npm run build:preview-runtime && node scripts/ux7-adapter-contract-tests.mjs",
    "test:consultation": "npm run build:preview-runtime && node scripts/consultation-contract-tests.mjs",
    "test:delegation": "npm run build:preview-runtime && node scripts/intelligence-delegation-tests.mjs",
    "test:intelligence-presentation": "npm run build:preview-runtime && node scripts/intelligence-presentation-tests.mjs",
    "homologate:intelligence:browser": "node scripts/intelligence-browser-homologation.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
